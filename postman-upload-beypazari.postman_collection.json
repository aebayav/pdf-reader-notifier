{
  "info": {
    "_postman_id": "1d2c8d6b-7b72-4f52-8f63-beypazari-test",
    "name": "PDF Reader Notifier - Beypazari Upload Test",
    "description": "Imports a ready-to-run multipart/form-data request for testing BEYPAZARI SOZLESME FORTIS.pdf against the local backend upload endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Upload BEYPAZARI SOZLESME FORTIS PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "C:\\Users\\abaya\\Downloads\\BEYPAZARI SÖZLEŞME FORTİS.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications",
            "upload"
          ]
        },
        "description": "Sends the selected PDF as multipart/form-data with key `file`. Do not manually set Content-Type; Postman will generate the correct multipart boundary."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response is either success or readable OCR failure', function () {",
              "    pm.expect([200, 422]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Response body is JSON', function () {",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('Success response is an array', function () {",
              "        pm.expect(body).to.be.an('array');",
              "    });",
              "}",
              "",
              "if (pm.response.code === 422) {",
              "    pm.test('OCR failure response has expected shape', function () {",
              "        pm.expect(body).to.have.property('code', 'PDF_READ_FAILED');",
              "        pm.expect(body).to.have.property('message');",
              "    });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
